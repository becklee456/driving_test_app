# Copy to server/.env and fill in real values. Never commit server/.env
# (it is git-ignored and excluded via .vercelignore).

# --- Runtime ---
NODE_ENV=development
PORT=5000
APP_NAME=Ikizamini cyo Gutwara
LOG_LEVEL=debug

# --- URLs / CORS ---
CLIENT_URL=http://localhost:5173
# Comma-separated allowlist; falls back to CLIENT_URL when unset.
CORS_ORIGINS=http://localhost:5173

# --- Database (MongoDB Atlas) ---
# Production / default URI (must NOT be used by tests):
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/rwanda_driving_test?retryWrites=true&w=majority
# Test URI. The database name MUST contain "test" - tests refuse otherwise:
TEST_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/rwanda_driving_test_test?retryWrites=true&w=majority

# --- Secrets (REQUIRED in production, >= 24 chars each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# --- Tokens / cookies ---
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
SECURE_COOKIES=1
COOKIE_SAMESITE=lax

# --- Security tuning ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=15
PASSWORD_MIN_LENGTH=8
REQUIRE_2FA_FOR_ADMINS=0
TRUST_PROXY=1

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
WRITE_RATE_LIMIT_MAX=120

# --- Mail ---
# transport: outbox (dev, no external send) | smtp
MAIL_TRANSPORT=outbox
MAIL_FROM=no-reply@ikizamini.rw
SUPPORT_EMAIL=support@ikizamini.rw
EXPOSE_OUTBOX=0

# --- Seed accounts (change for any shared/staging environment) ---
SEED_ADMIN_EMAIL=admin@ikizamini.rw
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=editor@ikizamini.rw
SEED_EDITOR_PASSWORD=
SEED_MODERATOR_EMAIL=moderator@ikizamini.rw
SEED_MODERATOR_PASSWORD=
SEED_STUDENT_EMAIL=student@ikizamini.rw
SEED_STUDENT_PASSWORD=
