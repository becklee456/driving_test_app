# ------------------------------------------------------------------
# Ikizamini cyo Gutwara - server environment
# Copy to server/.env and adjust. Never commit the real .env file.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000
APP_NAME=Ikizamini cyo Gutwara
LOG_LEVEL=debug

# Database (MongoDB Atlas)
# Get from Atlas -> Connect -> Drivers -> copy the "mongodb+srv://..." string,
# replace <db_name> with the database names below. Encode special characters
# in the password (e.g. @ -> %40).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/rwanda_driving_test?retryWrites=true&w=majority
# Used by the test suite only
TEST_MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/rwanda_driving_test_test?retryWrites=true&w=majority

# Client / CORS (comma separated list)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secrets - REQUIRED in production (>= 24 characters each).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_TTL_DAYS=30

# Cookies (set SECURE_COOKIES=true and COOKIE_SAMESITE=none behind HTTPS)
SECURE_COOKIES=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=15
PASSWORD_MIN_LENGTH=8
REQUIRE_2FA_FOR_ADMINS=false
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
WRITE_RATE_LIMIT_MAX=120

# Mail: 'outbox' stores messages in the DB (development). Swap for SMTP in production.
MAIL_TRANSPORT=outbox
MAIL_FROM=no-reply@ikizamini.rw
SUPPORT_EMAIL=support@ikizamini.rw
EXPOSE_OUTBOX=true

# Seed accounts (created by `npm run seed`)
SEED_ADMIN_EMAIL=admin@ikizamini.rw
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EDITOR_EMAIL=editor@ikizamini.rw
SEED_EDITOR_PASSWORD=Editor@12345
SEED_MODERATOR_EMAIL=moderator@ikizamini.rw
SEED_MODERATOR_PASSWORD=Mod@12345
SEED_STUDENT_EMAIL=student@ikizamini.rw
SEED_STUDENT_PASSWORD=Student@12345
